# 로컬 DB 접속 정보 — 이 파일을 같은 폴더에 `.env` 로 복사한 뒤 값을 채운다.
# `.env` 는 .gitignore 로 막혀 있어 커밋되지 않는다. 값은 PC마다 다르다.
# 배포 환경에서는 `.env` 대신 같은 이름의 환경변수를 준다 (환경변수가 우선).

# 형식: jdbc:mysql://<호스트>:<포트>/<데이터베이스>
NEWBEEZ_DB_URL=
NEWBEEZ_DB_USERNAME=
NEWBEEZ_DB_PASSWORD=

# 테이블 자동 생성 — 로컬 학습용. `update` 는 없는 테이블·컬럼을 만들어 준다.
# 이 줄이 없으면 기본값 `validate`(만들지 않고 엔티티와 맞는지 검사만)가 쓰인다.
# 배포 환경에서는 이 변수를 주지 않는다.
NEWBEEZ_DDL_AUTO=update
